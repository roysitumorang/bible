          "200": {
            "description": "successful operation",
            "schema": {
              "$ref": "#/definitions/ResponseLanguages"
            }
          }
        }
      }
    },
    "/verses": {
      "get": {
        "description": "Get verses",
        "produces": [
          "application/json"
        ],
        "tags": [
          "Verse"
        ],
        "operationId": "FindVerses",
        "parameters": [
          {
            "type": "string",
            "name": "version",
            "in": "query",
            "required": true
          },
          {
            "type": "string",
            "name": "q",
            "in": "query",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "schema": {
              "$ref": "#/definitions/ResponsePassages"
            }
          }
        }
      }
    },
    "/versions/{versionUid}": {
      "get": {
        "description": "Get version by UID",
